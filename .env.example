# Copier en .env
DATABASE_URL="postgresql://postgres:nudge@localhost:5432/nudge"
AUTH_SECRET=""            # npx auth secret
AUTH_GOOGLE_ID=""         # Google Cloud Console > OAuth 2.0 Client ID (web), redirect: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_SECRET=""
TZ="Europe/Paris"         # fuseau utilisé pour les créneaux (ponytail: un fuseau global, par utilisateur plus tard)
