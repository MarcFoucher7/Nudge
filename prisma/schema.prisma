// Nudge — schéma Prisma (PostgreSQL : Supabase ou Neon)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (Google OAuth) ----------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Streaks (dénormalisés : un seul utilisateur, une seule ligne)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveOn  DateTime? // minuit local du dernier jour actif
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  projects Project[]
  tasks    Task[]
}

// Stocke access_token + refresh_token Google (scope calendar)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ---------- Métier ----------
enum MentalLoad {
  HIGH
  MEDIUM
  LOW
}

enum Method {
  POMODORO
  SPACED_REPETITION
  ACTIVE_RECALL
  NONE
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("mint") // mint | butter | salmon | sky
  deadline  DateTime?
  // Effet de progression dotée : la jauge démarre à 5 %.
  // progress = 5 + 95 * (tâches faites / tâches totales), calculé en lecture.
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([userId])
}

model Task {
  id              String     @id @default(cuid())
  userId          String
  projectId       String?
  title           String
  description     String?
  durationMinutes Int        @default(25)
  mentalLoad      MentalLoad @default(MEDIUM)
  method          Method     @default(NONE)
  scheduledAt     DateTime?  // créneau dans le calendrier
  completedAt     DateTime?
  snoozeCount     Int        @default(0)
  googleEventId   String?    @unique // lien Google Calendar (sync bidirectionnelle)
  // Série de révisions (Méthode des J) : les occurrences J+1/J+3/J+7 pointent vers la 1re
  seriesId        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, scheduledAt])
  @@index([projectId])
}
